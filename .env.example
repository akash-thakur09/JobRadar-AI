# ==============================================================================
# JobRadar AI — Environment Configuration Template
# ==============================================================================

# Core Application Settings
APP_NAME="JobRadar AI"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# PostgreSQL Database Configuration
# Runtime async driver: asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobradar_ai
# Migrations sync driver: psycopg
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jobradar_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis Infrastructure Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Task Broker & Result Backend
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Future Integrations (Placeholders)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
STORAGE_DIR=storage
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

